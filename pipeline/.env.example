# Copy this file to pipeline/.env and fill in ONE key. pipeline/.env is never committed.
# With a key set, refresh.py drafts plain-language sentences for "facts only" items.
# Every sentence is published only if its quote is found word for word in the City's record.

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# OpenRouter keys start with sk-or-. They reach DeepSeek and other models through openrouter.ai.
OPENROUTER_API_KEY=

# Optional. Which provider to use: openai, deepseek, openrouter or ollama.
# Empty means the first provider above that has a key.
BTV_AI_PROVIDER=

# Optional. Defaults: gpt-4o-mini (OpenAI), deepseek-chat (DeepSeek),
# deepseek/deepseek-chat (OpenRouter), llama3.1 (Ollama).
BTV_AI_MODEL=
